Options -Indexes
DirectoryIndex index.html

# Security Headers
Header always set X-Frame-Options SAMEORIGIN
Header always set X-Content-Type-Options nosniff
Header always set Referrer-Policy strict-origin-when-cross-origin
Header always set X-XSS-Protection "1; mode=block"

# Force HTTPS (Hostinger reverse proxy compatible)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# -------------------------------------------------------
# TRAILING SLASH FIX — fixes GSC "Redirect error" on all pages
# Apache was serving /about as 200 OK instead of 301 to /about/
# This rule: if URL is a real directory AND has no trailing slash → 301 redirect to slash version
# Condition: only fires for actual directories (out/about/index.html exists as folder)
# Does NOT affect files, assets, _next/, or homepage /
# -------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# 404
ErrorDocument 404 /404.html

# Allow verified search engine bots — bypass rate limiting
SetEnvIfNoCase User-Agent "bingbot" good_bot
SetEnvIfNoCase User-Agent "adidxbot" good_bot
SetEnvIfNoCase User-Agent "BingPreview" good_bot
SetEnvIfNoCase User-Agent "MicrosoftPreview" good_bot
SetEnvIfNoCase User-Agent "Googlebot" good_bot
SetEnvIfNoCase User-Agent "Slurp" good_bot
SetEnvIfNoCase User-Agent "DuckDuckBot" good_bot
SetEnvIfNoCase User-Agent "YandexBot" good_bot
SetEnvIfNoCase User-Agent "Applebot" good_bot
SetEnvIfNoCase User-Agent "GPTBot" good_bot
SetEnvIfNoCase User-Agent "ClaudeBot" good_bot
SetEnvIfNoCase User-Agent "facebookexternalhit" good_bot
SetEnvIfNoCase User-Agent "Twitterbot" good_bot
SetEnvIfNoCase User-Agent "DotBot" good_bot
SetEnvIfNoCase User-Agent "SemrushBot" good_bot
SetEnvIfNoCase User-Agent "AhrefsBot" good_bot
SetEnvIfNoCase User-Agent "PerplexityBot" good_bot

# Block WordPress scanner attacks at Apache level (reduces Imunify360 false-positive triggers)
RewriteCond %{REQUEST_URI} ^/wp-admin [NC]
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_URI} ^/wp-login\.php [NC]
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_URI} ^/xmlrpc\.php [NC]
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteRule ^ - [F,L]